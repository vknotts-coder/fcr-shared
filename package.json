{
  "name": "@fcr/core",
  "version": "0.2.0",
  "description": "Shared FCR platform code — RBAC engine + frozen contracts + session config. Consumed by the fcr-* apps as a public immutable-SHA tag tarball. See fcr-dispatch#59.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./rbac": {
      "types": "./dist/rbac/index.d.ts",
      "default": "./dist/rbac/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "default": "./dist/session/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "iron-session": "^8.0.4",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "iron-session": ">=8"
  }
}
